[Unit]
Description=MCT Trigger T6 USB Display Driver
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=PYTHON_BIN REPO_ROOT/userspace/mct_t6_display.py --mirror --fps 1 --reconnect-interval 3 --send-workers 2 --quality-profile balanced --jpeg-quality 95 --jpeg-subsampling 2 --stats-interval 30
Restart=always
RestartSec=3
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
PassEnvironment=DBUS_SESSION_BUS_ADDRESS DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_RUNTIME_DIR XDG_SESSION_TYPE

[Install]
WantedBy=default.target
