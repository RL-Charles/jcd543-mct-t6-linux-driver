# SPDX-License-Identifier: GPL-2.0-only
[Unit]
Description=Opt-in guarded JCD543 MCT HDMI controller
Documentation=file:/usr/share/doc/jcd543-trigger6/INSTALLATION.md
After=systemd-udevd.service
ConditionPathExists=/etc/jcd543-trigger6/approved.json

[Service]
Type=exec
ExecStart=/usr/bin/python3 -I -B /usr/lib/jcd543-trigger6/controller.py watch --apply
ExecStop=/usr/bin/python3 -I -B /usr/lib/jcd543-trigger6/controller.py stop --apply
Restart=no
TimeoutStopSec=15
RuntimeDirectory=jcd543-trigger6
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_MODULE
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/jcd543-trigger6
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
# CAP_SYS_MODULE and exact USB-interface unbind remain necessary. Deliberately
# do not enable ProtectKernelModules/ProtectKernelTunables or private devices.

[Install]
WantedBy=multi-user.target
