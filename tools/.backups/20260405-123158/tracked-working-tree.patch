+		mutex_lock(&t6->io_lock);
+		ret = t6_send_frame(t6, head, head->tx_front, len);
+		mutex_unlock(&t6->io_lock);
+		drm_dev_exit(idx);
+		if (ret) {
+			t6_trip_transport_fault(t6, head, ret, "drm");
+			dev_warn_ratelimited(&t6->udev->dev,
+					     "Frame send failed on output %u: %d\n",
+					     head->output_idx, ret);
+			return;
+		}
+	}
