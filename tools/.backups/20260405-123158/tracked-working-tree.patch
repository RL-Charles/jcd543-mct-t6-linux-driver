+	for (;;) {
+		if (t6->io_faulted)
+			return;
+
+		mutex_lock(&t6->tx_lock);
+		head = t6_pop_pending_head_locked(t6, &len);
+		if (!head) {
+			mutex_unlock(&t6->tx_lock);
