+static int t6_alloc_head_buffers(struct t6_device *t6)
+{
+	unsigned int idx;
+
+	for (idx = 0; idx < T6_OUTPUT_COUNT; idx++) {
+		struct t6_head *head = t6_get_head(t6, idx);
