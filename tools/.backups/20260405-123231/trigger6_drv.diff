+static int t6_bulk_write(struct t6_device *t6, const void *src, size_t len)
+{
+	u8 *chunk_buf;
+	const u8 *cursor = src;
+	size_t remaining = len;
+	int ret = 0;
+
+	if (!len)
+		return 0;
+
+	chunk_buf = kmalloc(T6_USB_XFER_CHUNK_SIZE, GFP_KERNEL);
+	if (!chunk_buf)
+		return -ENOMEM;
+
+	while (remaining) {
+		size_t chunk = min_t(size_t, T6_USB_XFER_CHUNK_SIZE, remaining);
+		int actual = 0;
+
+		memcpy(chunk_buf, cursor, chunk);
+		ret = usb_bulk_msg(t6->udev,
+				   usb_sndbulkpipe(t6->udev, T6_EP_BULK_OUT),
+				   chunk_buf,
+				   chunk,
+				   &actual,
+				   T6_USB_XFER_TIMEOUT_MS);
+		if (ret < 0)
+			break;
+		if (actual != chunk) {
+			ret = -EIO;
+			break;
+		}
+
+		cursor += chunk;
+		remaining -= chunk;
+	}
+
+	kfree(chunk_buf);
+	return ret;
+}
